# ==============================================================================
# JalSuraksha — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=jalsuraksha-super-secret-development-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Feature Flags
FEATURE_SIMULATOR_MODE=false
FEATURE_LIVE_STREAMING=true
FEATURE_AI_ASSISTANT=true
FEATURE_SMS_ALERTS=false

# Database Configuration (PostgreSQL 16 + PostGIS + TimescaleDB)
POSTGRES_USER=jalsuraksha
POSTGRES_PASSWORD=jalsuraksha_secure_dev_pass
POSTGRES_DB=jalsuraksha_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jalsuraksha:jalsuraksha_secure_dev_pass@localhost:5432/jalsuraksha_db

# Redis (Caching & Pub/Sub for Real-Time Streaming)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3 for Satellite Rasters & Export Files)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=jalsuraksha-storage
S3_REGION=ap-south-1

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/stream
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_DEFAULT_LOCALE=en

# External Data Integrations (Optional keys, zero-blocker fallbacks available)
DATA_GOV_IN_API_KEY=
IMD_API_KEY=
INDIA_WRIS_TOKEN=
CPCB_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=jalsuraksha_groundwater_forecasting
